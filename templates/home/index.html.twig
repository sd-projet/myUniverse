{% extends 'dashboard/index.html.twig' %}

{% block title %}MyUniverse{% endblock %}

{% block body %}

    <section class="welcome-section">
        <h1>Bienvenue sur MyUniverse</h1>
        <p>
            Créez votre propre galaxie et explorez l'univers personnalisé
            qui vous est dédié.
        </p>
    </section>

    <div class="home-feed">

        {% for partage in partages %}

            <article class="share-card">

                <div class="share-card-header">
                    <img src="{{ asset('uploads/profile_pictures/' ~ partage.user.profilePicture) }}"
                         alt="Photo de profil de {{ partage.user.name }}"
                         class="profile-pic">

                    <div class="share-user">
                        <span class="username">
                            {{ partage.user.name }}
                        </span>

                        <span class="share-date">
                            {{ partage.createdAt
                                ? partage.createdAt|date('d/m/Y à H:i')
                                : '' }}
                        </span>
                    </div>
                </div>

                <div class="share-card-image">
                    <img src="{{ partage.imageUrl }}"
                         alt="Partage de {{ partage.user.name }}">
                </div>

                <div class="share-card-content">

                    <div class="share-actions">
                        <button type="button"
                                class="share-action-button like-btn"
                                aria-label="Aimer">
                            <i class="far fa-heart"></i>
                        </button>

                        <button type="button"
                                class="share-action-button comment-btn"
                                aria-label="Commenter">
                            <i class="far fa-comment"></i>
                        </button>
                    </div>

                    {% if partage.description %}
                        <p class="share-description">
                            {{ partage.description }}
                        </p>
                    {% endif %}

                </div>

            </article>

        {% else %}

            <div class="empty-state">
                <i class="fas fa-globe"></i>
                <p>Aucun partage à afficher pour le moment.</p>
            </div>

        {% endfor %}

    </div>

{% endblock %}