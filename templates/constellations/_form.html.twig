{% block body %}
    {{ form_start(form, {'attr': {'class': 'form-container2'}}) }}

    <div class="form-content constellation-form">

        <div class="constellation-settings">

            <div class="form-group2">
                {{ form_label(form.name, 'Nom de la constellation') }}

                {{ form_widget(form.name, {
                    'attr': {
                        'class': 'form-control',
                        'placeholder': 'Nom de votre constellation'
                    }
                }) }}
            </div>

            <div class="form-group2">
                {{ form_label(form.description, 'Description') }}

                {{ form_widget(form.description, {
                    'attr': {
                        'class': 'form-control',
                        'placeholder': 'Décrivez votre constellation'
                    }
                }) }}
            </div>

            <div class="form-group2">
                <label for="etoile-select">
                    <i class="fas fa-star"></i>
                    Étoiles
                </label>

                <p class="form-help">
                    Sélectionnez les étoiles à ajouter à votre constellation.
                </p>

                <select id="etoile-select">
                    {% for star in userStars %}
                        <option value='{{ {
                            "name": star.name,
                            "x": star.xPosition,
                            "y": star.yPosition,
                            "color": star.color
                        }|json_encode|raw }}'>
                            {{ star.name }}
                        </option>
                    {% endfor %}
                </select>

                <div id="selected-stars"></div>
            </div>

            <input
                type="hidden"
                id="etoile-json"
                name="etoile_json"
                value='{{ etoiles_json|raw }}'
            >

            <input
                type="hidden"
                id="lines-json"
                name="lines_json"
                value='{{ constellation.lines|json_encode|raw }}'
            >

            <div class="form-footer">
                <button type="submit">
                    {{ button_label|default('Créer ma constellation') }}
                </button>
            </div>

        </div>

        <div class="star-preview constellation-preview">

            <h2>Prévisualisation</h2>

            <div
                id="threejs-containerConstel"
                data-constellation-id="{{ constellation.id }}">
            </div>

        </div>

    </div>

    {{ form_end(form) }}
{% endblock %}