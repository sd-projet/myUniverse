<form method="post"
      action="{{ path('app_constellations_delete', {'id': constellation.id}) }}"
      onsubmit="return confirm('Êtes-vous sûre de vouloir supprimer cette constellation ?');">

    <input type="hidden"
           name="_token"
           value="{{ csrf_token('delete' ~ constellation.id) }}">

    <button class="delete-button" type="submit">
        <i class="fas fa-trash-alt"></i>
        Supprimer
    </button>
</form>