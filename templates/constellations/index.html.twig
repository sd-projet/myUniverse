{% extends 'dashboard/index.html.twig' %}

{% block title %}Mes Constellations{% endblock %}

{% block body %}

    <div class="page-header">
        <h1>Mes Constellations</h1>

        <a href="{{ path('app_constellations_new') }}"
           class="lienBtnCreate create-button">
            <i class="fas fa-plus"></i>
            Créer une constellation
        </a>
    </div>

    <div class="post-container">

        {% for constellation in constellations %}

            <article class="star-card">

                <div class="star-card-header">
                    <h2>{{ constellation.name }}</h2>
                </div>

                <div class="star-card-image">
                    <img src="{{ constellation.imageUrl }}"
                         alt="Constellation {{ constellation.name }}">
                </div>

                <div class="star-card-content">

                    {% if constellation.description %}
                        <p class="star-description">
                            {{ constellation.description }}
                        </p>
                    {% endif %}

                    <p class="star-date">
                        <i class="fas fa-calendar-alt"></i>
                        Créée le
                        {{ constellation.createdAt ? constellation.createdAt|date('d/m/Y à H:i') : '' }}
                    </p>

                </div>

                <div class="star-card-actions">

                    <a href="{{ path('app_constellations_edit', {'id': constellation.id}) }}"
                       class="edit-action">
                        <i class="fas fa-pen"></i>
                        Modifier
                    </a>

                    <form method="post"
                          action="{{ path('app_constellations_delete', {'id': constellation.id}) }}"
                          onsubmit="return confirm('Êtes-vous sûre de vouloir supprimer cette constellation ?');">

                        <input type="hidden"
                               name="_token"
                               value="{{ csrf_token('delete' ~ constellation.id) }}">

                        <button type="submit" class="delete-button">
                            <i class="fas fa-trash-alt"></i>
                            Supprimer
                        </button>

                    </form>

                </div>

            </article>

        {% else %}

            <div class="empty-state">
                <i class="fas fa-star"></i>

                <p>Vous n'avez encore aucune constellation.</p>

                <a href="{{ path('app_constellations_new') }}"
                   class="lienBtnCreate">
                    <i class="fas fa-plus"></i>
                    Créer ma première constellation
                </a>
            </div>

        {% endfor %}

    </div>

{% endblock %}