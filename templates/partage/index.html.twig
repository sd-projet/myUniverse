{% extends 'dashboard/index.html.twig' %}

{% block title %}Mes Partages{% endblock %}

{% block body %}

    <div class="page-header">
        <h1>Mes Partages</h1>

        <a href="{{ path('app_partage_new') }}"
           class="lienBtnCreate create-button">
            <i class="fas fa-plus"></i>
            Publier un post
        </a>
    </div>

    <div class="post-container">

        {% for partage in partages %}

            <article class="star-card">

                <div class="star-card-image">
                    <img src="{{ partage.imageUrl }}"
                         alt="Image du partage">
                </div>

                <div class="star-card-content">

                    {% if partage.description %}
                        <p class="star-description">
                            {{ partage.description }}
                        </p>
                    {% endif %}

                    <p class="star-date">
                        <i class="fas fa-calendar-alt"></i>
                        Publié le
                        {{ partage.createdAt
                            ? partage.createdAt|date('d/m/Y à H:i')
                            : '' }}
                    </p>

                </div>

                <div class="star-card-actions">

                    <a href="{{ path('app_partage_edit', {'id': partage.id}) }}"
                       class="edit-action">
                        <i class="fas fa-pen"></i>
                        Modifier
                    </a>

                    <form method="post"
                          action="{{ path('app_partage_delete', {'id': partage.id}) }}"
                          onsubmit="return confirm('Êtes-vous sûre de vouloir supprimer ce partage ?');">

                        <input type="hidden"
                               name="_token"
                               value="{{ csrf_token('delete' ~ partage.id) }}">

                        <button type="submit"
                                class="delete-button">
                            <i class="fas fa-trash-alt"></i>
                            Supprimer
                        </button>

                    </form>

                </div>

            </article>

        {% else %}

            <div class="empty-state">
                <i class="fas fa-share-alt"></i>

                <p>Vous n'avez encore aucun partage.</p>

                <a href="{{ path('app_partage_new') }}"
                   class="lienBtnCreate">
                    <i class="fas fa-plus"></i>
                    Publier mon premier post
                </a>
            </div>

        {% endfor %}

    </div>

{% endblock %}