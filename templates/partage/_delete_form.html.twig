<form method="post"
      action="{{ path('app_partage_delete', {'id': partage.id}) }}"
      onsubmit="return confirm('Êtes-vous sûre de vouloir supprimer ce partage ?');">

    <input type="hidden"
           name="_token"
           value="{{ csrf_token('delete' ~ partage.id) }}">

    <button class="delete-button" type="submit">
        <i class="fas fa-trash-alt"></i>
        Supprimer
    </button>

</form>