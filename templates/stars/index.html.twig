{% extends 'dashboard/index.html.twig' %}

{% block title %}Mes Stars
{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Mes Stars</h1>

        <a href="{{ path('app_stars_new') }}" class="lienBtnCreate create-button">
            <i class="fas fa-plus"></i>
            Créer ma star
        </a>
    </div>

    <div class="post-container">
		{% for star in stars %}
			<article class="star-card">

				<div class="star-card-header">
					<h2>{{ star.name }}</h2>
				</div>

				<div class="star-card-image">
					<img src="{{ star.imageUrl }}" alt="Étoile {{ star.name }}">
				</div>

				<div class="star-card-content">

					{% if star.description %}
						<p class="star-description">
							{{ star.description }}
						</p>
					{% endif %}

					<p class="star-date">
						<i class="fas fa-calendar-alt"></i>
						Créée le {{ star.createdAt ? star.createdAt|date('d/m/Y à H:i') : '' }}
					</p>

				</div>

				<div class="star-card-actions">
					<a href="{{ path('app_stars_edit', {'id': star.id}) }}"
					class="star-action edit-action">
						<i class="fas fa-pen"></i>
						Modifier
					</a>

					{{ include('stars/_delete_form.html.twig') }}
					
				</div>

			</article>
		{% else %}
			<div class="empty-state">
				<i class="fas fa-star"></i>
				<p>Vous n'avez encore aucune étoile.</p>

				<a href="{{ path('app_stars_new') }}" class="lienBtnCreate">
					<i class="fas fa-plus"></i>
					Créer ma première étoile
				</a>
			</div>
		{% endfor %}
	</div>
{% endblock %}