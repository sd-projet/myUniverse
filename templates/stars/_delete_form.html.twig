<form method="post"
      action="{{ path('app_stars_delete', {'id': star.id}) }}"
      onsubmit="return confirm('Êtes-vous sûre de vouloir supprimer cette étoile ?');">

    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ star.id) }}">

    <button class="delete-button" type="submit">
        <i class="fas fa-trash-alt"></i>
        Supprimer
    </button>
</form>